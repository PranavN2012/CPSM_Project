# Copy this file to .env and fill in your real key(s).
# .env is gitignored — it will never be committed.
#
# Only one of these is required. If both are set, GROQ_API_KEY is preferred
# (see LLM_PROVIDER below to override that).

# Groq (OpenAI-compatible chat API) — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: force a specific provider instead of auto-detecting from which
# key is set. Values: "groq" | "gemini"
# LLM_PROVIDER=
